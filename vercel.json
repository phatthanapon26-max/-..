{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/*.js": {
      "maxDuration": 30,
      "includeFiles": "{deploy-config.js,features.js,vendor/fonts/*.ttf}"
    }
  },
  "crons": [
    {
      "path": "/api/daily-report?slot=00",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/daily-report?slot=01",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/daily-report?slot=02",
