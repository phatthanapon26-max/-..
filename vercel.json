{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/*.js": { "maxDuration": 30 }
  },
  "crons": [
    { "path": "/api/daily-report", "schedule": "0 1 * * *" },
    { "path": "/api/daily-report", "schedule": "0 11 * * *" }
  ]
}
